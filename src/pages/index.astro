---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)

const postDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})

const projects = [
  {
    name: 'pond',
    href: 'https://pond.locker',
    line: 'Lossless archive and search for AI agent sessions, kept in storage you own. Rust and Lance.',
  },
  {
    name: 'glim',
    href: 'https://glim.sh',
    line: 'Live data for AI agents over MCP, paid per call with x402 micropayments. 43,000+ calls settled on-chain.',
  },
  {
    name: 'cuttle',
    href: 'https://github.com/glim-sh/cuttle',
    line: 'A browser for AI agents that websites do not block: keeps logins, human takeover for captchas. Stealth Chromium behind one CDP endpoint.',
  },
  {
    name: 'blackbox',
    href: 'https://github.com/tenequm/blackbox',
    line: 'macOS menu bar app that records your calls, starting and stopping by itself. No bot, no account, files stay on your Mac.',
  },
]
---

<BaseLayout title="Mykhaylo Kolesnik. Senior infrastructure engineering.">
  <section
    class="max-w-2xl w-full mx-auto px-6 py-4 flex-1 flex flex-col sm:justify-center"
  >
    <h1 class="font-serif text-3xl sm:text-4xl leading-tight tracking-tight mb-5">
      I build infrastructure for AI agents.
    </h1>
    <p class="text-ink-muted leading-relaxed mb-8">
      Nine years of senior infrastructure engineering: SRE team lead at Takeoff Technologies
      (Walmart and Costco warehouse automation), solo infrastructure engineer at Gasp, CTO at
      Lavarage.
    </p>

    <div class="space-y-4 mb-7">
      {
        projects.map((p) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block border-l-2 border-accent pl-5 -ml-[22px] text-ink hover:text-ink no-underline hover:no-underline hover:border-accent-deep"
          >
            <p class="font-mono text-base font-medium text-accent group-hover:text-accent-deep mb-0.5">
              {p.name}
            </p>
            <p class="leading-relaxed text-sm">{p.line}</p>
          </a>
        ))
      }
    </div>

    {
      posts.length > 0 && (
        <div class="border border-rule bg-bg-raised px-5 py-3 mb-7">
          <p class="font-mono text-xs text-ink-muted mb-2">writing</p>
          <ul>
            {posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="group flex flex-col sm:flex-row sm:items-baseline gap-x-5 gap-y-0.5 py-1.5 text-ink hover:text-ink no-underline hover:no-underline"
                >
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono text-xs text-ink-muted tabular-nums shrink-0 sm:w-24"
                  >
                    {postDate.format(post.data.pubDate)}
                  </time>
                  <span class="font-serif group-hover:text-accent transition-colors">
                    {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="font-mono text-sm text-ink-muted">
      Consulting: I fix the infrastructure nobody owns.{' '}
      <a href="/work">details &rarr;</a>
    </p>
  </section>
</BaseLayout>
