---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const calendly = 'https://calendly.com/tenequm/30min'

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)

const postDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})

const services = [
  {
    name: 'Audit',
    price: '$5-8k',
    duration: '1-2 weeks',
    outcome:
      'Diagnostic of an AI-agent system, data platform, or the infrastructure under it. Output: written assessment, prioritized roadmap, specific risk callouts, recommended fixes.',
    fit: 'Good fit if you have shipped a prototype and need to know what is brittle before scaling, or you are scoping a build and want a senior engineer to pressure-test the plan.',
  },
  {
    name: 'Sprint',
    price: '$16-24k',
    duration: '4-6 weeks',
    outcome:
      'Build of a defined capability: agent system, data pipeline, retrieval, evaluation harness, internal tool. Production-ready, not POC.',
    fit: 'Good fit if you have a scoped problem and need it shipped reliably, with the infrastructure to keep it stable.',
  },
  {
    name: 'Stabilization retainer',
    price: '$6-10k',
    duration: 'monthly',
    outcome:
      'Ongoing senior oversight: agent and prompt tuning, evals, data pipelines, infrastructure ownership, on-call for AI-system issues.',
    fit: 'Good fit if you shipped an AI system and need a senior engineer on call who actually understands the production path.',
  },
]

const now = [
  {
    name: 'pond',
    tag: 'Open source',
    text: 'Lossless archive and search for AI agent sessions: every message, tool call, and result from every agentic client, kept in storage you own, searchable over MCP, restorable into any client. Rust and Lance. Runs my own archive of 12,557 sessions and 2.25M messages.',
    links: [
      { href: 'https://github.com/tenequm/pond', label: 'github.com/tenequm/pond' },
      { href: 'https://pond.locker', label: 'pond.locker' },
    ],
  },
  {
    name: 'glim',
    tag: 'Live product',
    text: 'Live data for AI agents: web, Twitter, Reddit, GitHub, and more, served over MCP and paid per call with x402 micropayments. 43,000+ calls settled on-chain. Co-launched with the Solana Foundation.',
    links: [{ href: 'https://glim.sh', label: 'glim.sh' }],
  },
]

const solana = [
  {
    href: 'https://solscan.io/account/SPL1T3rERcu6P6dyBiG7K8LUr21CssZqDAszwANzNMB',
    label: 'payment splitting',
  },
  {
    href: 'https://solscan.io/account/DEADaT1auZ8JjUMWUhhPWjQqFk9HSgHBkt5KaGMVnp1H',
    label: 'deadline validation',
  },
  {
    href: 'https://solscan.io/account/satiFVb9MDmfR4ZfRedyKPLGLCg3saQ7Wbxtx9AEeeF',
    label: 'agent identity (ERC-8004)',
  },
]

const roles = [
  {
    role: 'Solo infrastructure engineer',
    org: 'Gasp / Mangata Finance',
    period: 'Sep 2022 to 2026',
    line: '$3M peak TVL, 22 months zero outages across 25 GKE nodes and 100+ microservices. Reference: Peter Kris, CEO, on request.',
  },
  {
    role: 'DevOps to CTO',
    org: 'Lavarage (Pine Protocol)',
    period: 'Jun 2022 to Jun 2023',
    line: 'Promoted to CTO after 6 months. Launched a DeFi protocol mainnet 30 days from inception; $2.8M peak TVL.',
  },
  {
    role: 'Senior platform engineer',
    org: 'NinjaHoldings',
    period: 'Aug 2021 to Jun 2022',
    line: 'US fintech. Migrated 30+ Python services EC2 to EKS; API p95 2.1s to 340ms.',
  },
  {
    role: 'Sole DevOps to SRE team lead',
    org: 'Takeoff Technologies',
    period: 'Mar 2018 to Jul 2020',
    line: 'Walmart and Costco warehouse automation across 8 isolated client environments; 99.95% uptime.',
  },
]
---

<BaseLayout title="Mykhaylo Kolesnik. Production systems for the AI-agent era.">
  <section class="max-w-3xl mx-auto px-6 pt-24 sm:pt-32 pb-20">
    <h1 class="font-display text-4xl sm:text-5xl leading-[1.05] tracking-tight mb-8">
      Production systems for the AI-agent era.
    </h1>
    <p class="text-lg text-ink-muted leading-relaxed mb-6 max-w-prose">
      Data platforms, AI-agent infrastructure, and the reliability discipline underneath.
    </p>
    <p class="leading-relaxed text-ink mb-10 max-w-prose">
      Nine years of senior infrastructure engineering. I build and operate my own production agent
      systems daily, and I take client systems from prototype to running unattended. I work as the
      senior engineer in the room, not as a packaged service. Every engagement starts with looking
      at what you have already shipped.
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href={calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-accent hover:bg-accent-deep text-bg px-5 py-3 font-medium tracking-wide transition-colors"
      >
        Book an intro call
      </a>
      <span class="text-sm text-ink-muted">Available now for new engagements.</span>
    </div>
  </section>

  <section id="services" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
    <h2 class="font-display text-2xl sm:text-3xl mb-12">Services</h2>
    <div class="space-y-12">
      {
        services.map((s) => (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-3">
              <h3 class="font-display text-2xl">{s.name}</h3>
              <p class="text-sm text-accent tracking-wide uppercase tabular-nums">
                {s.price}
                <span class="text-ink-faint"> / {s.duration}</span>
              </p>
            </div>
            <p class="leading-relaxed mb-3 text-ink">{s.outcome}</p>
            <p class="leading-relaxed text-sm text-ink-muted">{s.fit}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-12 pt-6 border-t border-rule text-ink-muted">
      Hands-on engineering engagements from <span class="text-ink">$100/hr</span>.
    </p>
  </section>

  <section id="now" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
    <h2 class="font-display text-2xl sm:text-3xl mb-12">Now</h2>
    <div class="space-y-12">
      {
        now.map((n) => (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-3">
              <h3 class="font-display text-2xl">{n.name}</h3>
              <p class="text-sm text-ink-faint uppercase tracking-wide">{n.tag}</p>
            </div>
            <p class="leading-relaxed text-ink mb-3 max-w-prose">{n.text}</p>
            <p class="text-sm">
              {n.links.map((l, i) => (
                <>
                  {i > 0 && <span class="text-ink-faint"> &middot; </span>}
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label}
                  </a>
                </>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="work" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
    <h2 class="font-display text-2xl sm:text-3xl mb-12">Recent work</h2>
    <article>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-3">
        <h3 class="font-display text-2xl leading-snug">Data platform for a US marketplace startup</h3>
        <p class="text-sm text-ink-faint tabular-nums shrink-0">Mar to Jul 2026, solo</p>
      </div>
      <p class="leading-relaxed text-ink max-w-prose">
        Took over a stalled data initiative and shipped it to production in six weeks. One engineer
        across the whole stack: a domain-keyed warehouse unifying nine data sources across email,
        calls, LinkedIn outreach, and direct mail (425k cross-source merges, zero orphans), a Go
        API, a self-serve ingestion UI the growth team uses without engineering in the loop,
        Terraform and AWS underneath. Built to run without its builder: scheduled,
        watermark-resuming pipelines operated unattended through the engagement and kept running
        after a clean July handover.
      </p>
    </article>
    <p class="mt-10 leading-relaxed text-ink-muted max-w-prose">
      Also deployed on Solana mainnet:{' '}
      {
        solana.map((l, i) => (
          <>
            {i > 0 && ', '}
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
            </a>
          </>
        ))
      }.
    </p>
    <div class="mt-14 pt-8 border-t border-rule">
      <h3 class="text-sm uppercase tracking-wide text-ink-faint mb-6">Roles</h3>
      <ul class="space-y-6">
        {
          roles.map((r) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <p class="font-medium text-ink">
                  {r.role}, {r.org}
                </p>
                <p class="text-sm text-ink-faint tabular-nums shrink-0">{r.period}</p>
              </div>
              <p class="text-sm text-ink-muted leading-relaxed mt-1">{r.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section id="blog" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
        <h2 class="font-display text-2xl sm:text-3xl mb-10">Blog</h2>
        <ul>
          {posts.map((post) => (
            <li class="border-t border-rule first:border-t-0">
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col sm:flex-row sm:items-baseline gap-x-6 gap-y-1 py-4 text-ink hover:text-ink"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-sm text-ink-faint tabular-nums shrink-0 sm:w-28"
                >
                  {postDate.format(post.data.pubDate)}
                </time>
                <span class="font-display text-lg group-hover:text-accent transition-colors">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm">
          <a href="/blog">All posts &rarr;</a>
        </p>
      </section>
    )
  }

  <section id="about" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
    <h2 class="font-display text-2xl sm:text-3xl mb-8">About</h2>
    <p class="text-lg leading-relaxed text-ink mb-6 max-w-prose">
      Based in Cascais, Portugal. Working primarily with North American teams.
    </p>
    <p class="leading-relaxed text-ink-muted max-w-prose">
      References from current and prior engagements available on request.
    </p>
    <p class="leading-relaxed text-ink-muted mt-3 max-w-prose">
      I sign client-provided DPAs and can provide a baseline GDPR-aligned data-processing
      agreement on request.
    </p>
  </section>

  <section id="contact" class="max-w-3xl mx-auto px-6 py-20 border-t border-rule">
    <h2 class="font-display text-2xl sm:text-3xl mb-8">Contact</h2>
    <p class="text-lg leading-relaxed text-ink mb-8 max-w-xl">
      The fastest path is a 30-minute intro call. If you prefer, email works too.
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-6">
      <a
        href={calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-accent hover:bg-accent-deep text-bg px-5 py-3 font-medium tracking-wide transition-colors"
      >
        Book an intro call
      </a>
      <a href="mailto:misha@kolesnik.io" class="text-base">misha@kolesnik.io</a>
    </div>
  </section>
</BaseLayout>
