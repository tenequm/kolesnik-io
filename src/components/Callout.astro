---
interface Props {
  title?: string
}

const { title = 'Note' } = Astro.props
---

<aside class="border-l-2 border-accent bg-bg-raised px-5 py-4 my-8">
  <p class="text-sm font-medium tracking-wide uppercase text-accent mb-1">{title}</p>
  <div class="text-ink leading-relaxed"><slot /></div>
</aside>
