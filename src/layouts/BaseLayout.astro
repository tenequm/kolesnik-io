---
import { Font } from 'astro:assets'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date | undefined
  ogImage?: string
}

const {
  title,
  description = 'Production systems for the AI-agent era: data platforms, agent infrastructure, reliability. Mykhaylo Kolesnik, senior infrastructure engineer. Available now.',
  type = 'website',
  pubDate,
  updatedDate,
  ogImage = '/og.png',
} = Astro.props

// build.format 'file' puts ".html" in build-time pathnames; canonical must match the clean served URLs
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '')
const canonical = new URL(cleanPath, Astro.site).toString()
const ogImageUrl = new URL(ogImage, Astro.site).toString()
const ogImageAlt = type === 'article' ? title : 'Mykhaylo Kolesnik. I fix the infrastructure nobody owns.'
// Restore with the blog nav link:
// const onBlog = cleanPath === '/blog' || cleanPath.startsWith('/blog/')
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Mykhaylo Kolesnik" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      type === 'article' && pubDate && (
        <meta property="article:published_time" content={pubDate.toISOString()} />
      )
    }
    {
      type === 'article' && updatedDate && (
        <meta property="article:modified_time" content={updatedDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Mykhaylo Kolesnik" href="/rss.xml" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body class="min-h-screen flex flex-col border-t-[6px] border-accent">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-bg focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <header class="border-b border-rule">
      <div
        class="max-w-3xl mx-auto px-6 py-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2"
      >
        <a href="/" class="font-display text-ink hover:text-accent">Mykhaylo Kolesnik</a>
        <nav class="flex items-center gap-x-5 text-sm">
          {
            /* Blog nav hidden until there are published posts.
          <a
            href="/blog"
            aria-current={onBlog ? 'page' : undefined}
            class="aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:underline-offset-[0.2em] aria-[current=page]:decoration-1"
          >
            Blog
          </a>
          */
          }
          <a href="/#services">Services</a>
          <a href="/#contact">Contact</a>
          <a
            href="https://github.com/tenequm"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-ink-muted hover:text-accent transition-colors"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              /></svg
            >
          </a>
          <a
            href="https://www.linkedin.com/in/tenequm"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-ink-muted hover:text-accent transition-colors"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
              /></svg
            >
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-rule mt-32 py-10">
      <div class="max-w-3xl mx-auto px-6 text-sm text-ink-muted flex flex-wrap gap-x-6 gap-y-2 items-baseline justify-between">
        <p class="leading-relaxed">
          Mykhaylo Kolesnik. Sole trader, Portugal. NIF PT321777301.
        </p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          {/* <a href="/blog">Blog</a> hidden until there are published posts */}
          <a href="/privacy">Privacy</a>
          <span class="text-ink-faint">© {year}</span>
        </nav>
      </div>
    </footer>
  </body>
</html>
